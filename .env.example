# ── Database ────────────────────────────────────────────────
# Railway's Postgres plugin injects DATABASE_URL automatically.
# For local dev you can paste the connection string here.
DATABASE_URL=postgresql://user:pass@host:5432/railway

# ── Claude (reuse 張特助's key) ──────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Set this to the SAME model string 張特助 uses.
ANTHROPIC_MODEL=claude-sonnet-5

# ── LINE (秀琴阿姨's OWN Messaging API channel — not 張特助's) ─
LINE_CHANNEL_ACCESS_TOKEN=...
LINE_CHANNEL_SECRET=...

# ── SimpleFIN: paste EITHER the one-time setup token OR an access url ──
# The setup token is auto-exchanged for an access url on first boot
# and the result is stored in the DB, so you only paste it once.
SIMPLEFIN_SETUP_TOKEN=
SIMPLEFIN_ACCESS_URL=

# ── Apple Card real-time via iOS Shortcut ───────────────────
# Make up a long random string; the iOS Shortcut sends it so randoms can't post fake charges.
INGEST_TOKEN=

# ── Behaviour ───────────────────────────────────────────────
TIMEZONE=America/Los_Angeles
POLL_INTERVAL_MIN=15      # how often she checks the bank
DEBOUNCE_MINUTES=5        # quiet window before she asks "what did you buy?"
BACKFILL_DAYS=45         # history to import silently on first run (no nagging)
